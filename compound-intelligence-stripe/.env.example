# Compound Intelligence - Stripe configuration.
#
# Copy to .env for local development. NEVER commit a filled-in copy, and never
# put a live key in one. In production these are set in Netlify under
# Site configuration > Environment variables, not in a file.

# Server-side key. Use a RESTRICTED key (rk_), not a secret key (sk_), scoped to
# Checkout Sessions, Customers, Subscriptions, Prices, Products and Billing
# Portal. Start with a sandbox key (rk_test_) - sandboxes isolate settings as
# well as data, so a webhook or tax experiment cannot reach the live account.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. Local value comes from
# `stripe listen`; the deployed value comes from the Dashboard endpoint you
# create. They are different - a mismatch shows up as 400 Invalid signature.
STRIPE_WEBHOOK_SECRET=

# Absolute origin, no trailing slash. Used to build Checkout return URLs.
SITE_URL=http://localhost:8888

# Publishable key (pk_). This one is safe to expose - it ships in client-side
# code by design. Only needed if you render Stripe.js on the frontend; the
# redirect-to-Checkout flow in this integration does not require it.
VITE_STRIPE_PUBLISHABLE_KEY=
