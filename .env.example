# Showing Up Phase 0 observation credentials.
# Copy to .env.local and export before a run, or set them in your shell.
# Never commit a filled-in copy of this file.
#
# Read each provider's terms on automated use before Phase 0 (SPEC 12.1).
# The harness runs whatever is configured and reports the rest as not run,
# so a partial set is a valid run with a smaller claim.

# ChatGPT, via the Responses API with web search.
OPENAI_API_KEY=
# Optional model override.
SHOWING_UP_OPENAI_MODEL=

# Gemini, via the Gemini API with Search grounding.
GEMINI_API_KEY=
SHOWING_UP_GEMINI_MODEL=

# Perplexity, via the Perplexity API.
PERPLEXITY_API_KEY=
SHOWING_UP_PERPLEXITY_MODEL=

# Claude, via the Anthropic API with web search. Also used by the optional
# cause-inference pass, which is labelled as inferred wherever it appears.
ANTHROPIC_API_KEY=
SHOWING_UP_ANTHROPIC_MODEL=

# Google AI Mode and Copilot have no API and are observed only by a consented
# panel session. There is no key for them by design: see the README.
