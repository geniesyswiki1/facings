{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tools/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/netlify/**/*.mts",
    "packages/*/test/**/*.ts",
    "tools/*/test/**/*.ts",
    "apps/*/test/**/*.ts"
  ]
}
