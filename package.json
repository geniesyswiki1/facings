{
  "name": "facings",
  "private": true,
  "version": "0.1.0",
  "description": "Facings: the agent channel manager for merchants who are not on Shopify. Phase 0 audit harness.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "audit": "tsx tools/audit-cli/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.11.1",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  }
}
